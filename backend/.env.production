# =================================
# UNT Comedor Backend - PRODUCCIÓN
# =================================

PORT=4000
NODE_ENV=production

#nada

# Base de Datos (Render PostgreSQL - Internal URL)
DATABASE_URL="postgresql://usuario:password@host:5432/unt_comedor"

# JWT (usar un secreto fuerte en producción)
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_SEGURO_DE_64_CARACTERES_MINIMO
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# CORS (URL del frontend en Vercel)
FRONTEND_URL=https://untcomedor.vercel.app
