# =================================
# UNT Comedor Backend - Variables de Entorno
# =================================

# Servidor
PORT=4000
NODE_ENV=development

# Base de Datos (PostgreSQL)
DATABASE_URL="postgresql://usuario:password@localhost:5432/unt_comedor?schema=public"

# JWT
JWT_SECRET=tu_jwt_secret_super_seguro_aqui_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# Cloudinary (usa CLOUDINARY_URL o las 3 variables siguientes)
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME  (sin < >)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
# Opcional: preset sin firma si la API devuelve 403 al subir
# CLOUDINARY_UPLOAD_PRESET=unt_comedor_unsigned
# Si Cloudinary falla o no está configurado, guarda imágenes en /uploads
USE_LOCAL_UPLOADS=false
API_PUBLIC_URL=http://localhost:4000

# CORS
FRONTEND_URL=http://localhost:3000
